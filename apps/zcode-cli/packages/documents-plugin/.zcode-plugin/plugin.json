{
  "name": "documents",
  "version": "0.1.7",
  "description": "DOCX document production skills for ZCode-CE (DSH-based, MIT).",
  "description_i18n": {
    "en": "Word document production skills for DOCX: create, edit, format, check, and deliver.",
    "zh-CN": "面向 DOCX 的 Word 文档制作技能：创建、编辑、排版、结构校验与交付。"
  },
  "author": {
    "name": "DeepSeek Harness (MIT), adapted for ZCode-CE"
  },
  "license": "MIT",
  "skills": "skills",
  "agents": "agents",
  "mcpServers": {
    "documents": {
      "type": "stdio",
      "command": "node",
      "args": ["${ZCODE_PLUGIN_ROOT}/dist/server.mjs"],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "ZCODE_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "documents",
        "title": {
          "zh-CN": "Word 文档",
          "en-US": "Documents"
        },
        "icon": "file-text",
        "server": "documents",
        "resourceUri": "ui://documents/panel.html",
        "availability": "session"
      }
    ]
  }
}
