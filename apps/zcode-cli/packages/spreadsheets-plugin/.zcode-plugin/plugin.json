{
  "name": "spreadsheets",
  "version": "0.1.7",
  "description": "spreadsheets plugin for ZCode-CE (DSH-based, MIT).",
  "description_i18n": {
    "en": "Excel spreadsheet production skills for XLSX: create, edit, format, check, and deliver.",
    "zh-CN": "面向 XLSX 的电子表格制作技能：创建、编辑、格式化、结构校验与交付。"
  },
  "author": {
    "name": "DeepSeek Harness (MIT), adapted for ZCode-CE"
  },
  "license": "MIT",
  "skills": "skills",
  "agents": "agents",
  "mcpServers": {
    "spreadsheets": {
      "type": "stdio",
      "command": "node",
      "args": ["${ZCODE_PLUGIN_ROOT}/dist/server.mjs"],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "ZCODE_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "ui": {
    "surfaces": [
      {
        "id": "spreadsheets",
        "title": {
          "zh-CN": "电子表格",
          "en-US": "Spreadsheets"
        },
        "icon": "table",
        "server": "spreadsheets",
        "resourceUri": "ui://spreadsheets/panel.html",
        "availability": "session"
      }
    ]
  }
}
