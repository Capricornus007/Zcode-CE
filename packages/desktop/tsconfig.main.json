{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/main",
    "rootDir": "src",
    "lib": ["es2025"],
    // 同 host：产物由 tsup 打包，tsc 只做类型检查，禁止 emit 以免覆盖 bundle。
    "noEmit": true
  },
  // include 只补 src/shared/armsRumShared.ts（appARMSBootstrap 唯一的跨目录依赖）：
  // 整目录 src/shared 会把 renderer 侧的 armsBrowserInit/armsRumBridgeForward（用 window/document）拖进无 dom lib 的 main 工程。
  "include": ["src/main", "src/shared/armsRumShared.ts", "src/scheduler/schedulerProtocol.ts"],
  // main 直接依赖 shared 和 services；把引用补齐后，desktop 子工程也能稳定复用上游声明产物。
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
